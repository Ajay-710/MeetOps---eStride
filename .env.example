# MeetOps Studio - Environment Configuration Template
# Copy this file to .env.local for local development

# Google Gemini API Key (Optional: Ollama or Demo Mode available)
GEMINI_API_KEY=

# Basecamp 3 Integration Credentials (Account #5463662)
BASECAMP_ACCOUNT_ID=5463662
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=http://localhost:3000/api/auth/basecamp/callback

# (Optional: If you have a static Bearer Access Token)
BASECAMP_ACCESS_TOKEN=

# Ollama Host (Default is http://localhost:11434 for local LLM inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
